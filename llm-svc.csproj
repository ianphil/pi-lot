<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>llm_svc</RootNamespace>
    <Version>0.6.0</Version>
    <OutputType>WinExe</OutputType>
    <NoWarn>CA1416</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);llm-svc.Tests\**;llm-cli\**;llm-cli.Tests\**</DefaultItemExcludes>
    <UserSecretsId>13f9f324-1cb8-498a-974b-79931682afe6</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.5" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.91.1" />
  </ItemGroup>

</Project>
